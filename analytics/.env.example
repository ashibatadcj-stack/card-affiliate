# GA4 プロパティID（数字のみ）
# 取得方法: GA4 → 管理 → プロパティ列「プロパティの詳細」
GA4_PROPERTY_ID=123456789

# Search Console サイトURL（末尾スラッシュ必須）
GSC_SITE_URL=https://cardshindan.com/

# サービスアカウントJSONへのパス（リポジトリルートからの相対）
GOOGLE_APPLICATION_CREDENTIALS=analytics/credentials/service-account.json

# Slack通知 (オプション、未設定なら通知なし)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Claude API キーは ../env (リポジトリルート) から自動読込される
