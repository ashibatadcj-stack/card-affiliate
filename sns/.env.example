# SNS自動運用 環境変数雛形
# このファイルを `.env` にコピーして実際の値を記入してください。
# `.env` は .gitignore 済みなので git に commit されません。

# === X (Twitter) API ===
# https://developer.twitter.com/ → App → Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# === Threads API (Meta) ===
# https://developers.facebook.com/ → App → Threads → API Setup
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# === サイト設定（任意・上書き用）===
# デフォルトは https://cardshindan.com
# SITE_URL=https://cardshindan.com
